+// variant (hash = hash*33 + byte, u32 wraparound) -- matches make_3sr.py's
+// djb2() and docs/3sr-format.md section 4.3.
+static UINT32 Track3srDjb2(const UINT8* data, size_t len)
+{
+	UINT32 hash = 5381;
+	for (size_t i = 0; i < len; i++) {
