+// Appends the checksum table, patches frame_count/checksum_count into the
+// header, records the manifest row and resets per-game state. Called on the
+// in-game -> not-in-game transition and at end of session.
+static void Track3srFinalizeGame(const char* endReason)
+{
+	Track3srGameResult result;
+	memset(&result, 0, sizeof(result));
+	result.gameIndex = gTrackGameIndex;
+	result.signatureFound = gTrackSignatureFound;
+	result.frameCount = gTrackFrameCount;
+	result.checksumCount = (UINT32)gTrackChecksums.size();
+	result.recordsConsumedAtSignature = gTrackRecordsConsumedAtSignature;
+	snprintf(result.endReason, sizeof(result.endReason), "%s", endReason);
+	gTrackResults.push_back(result);
+
