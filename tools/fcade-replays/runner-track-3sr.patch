+		for (size_t i = 0; i < gTrackChecksums.size(); i++) {
+			UINT8 entry[8];
+			Track3srPutU32Le(&entry[0], gTrackChecksums[i].frame);
+			Track3srPutU32Le(&entry[4], gTrackChecksums[i].hash);
+			fwrite(entry, 1, sizeof(entry), gTrackGameFile);
+		}
+
+		UINT8 patch[4];
+		Track3srPutU32Le(patch, gTrackFrameCount);
+		fseek(gTrackGameFile, 20, SEEK_SET);   // frame_count (offset 0x14)
+		fwrite(patch, 1, 4, gTrackGameFile);
+		Track3srPutU16Le(patch, (UINT16)gTrackChecksums.size());
+		fseek(gTrackGameFile, 26, SEEK_SET);   // checksum_count (offset 0x1A)
+		fwrite(patch, 1, 2, gTrackGameFile);
+		fclose(gTrackGameFile);
+		gTrackGameFile = NULL;
+
+		printf("track-3sr: game_%u finalized (%s): frame_count=%u checksum_count=%u records_at_signature=%llu\n",
+			gTrackGameIndex, endReason, gTrackFrameCount, (UINT32)gTrackChecksums.size(),
+			(unsigned long long)gTrackRecordsConsumedAtSignature);
+	} else {
+		printf("track-3sr: game_%u ended (%s) with no game-start signature -- no .3sr written\n",
+			gTrackGameIndex, endReason);
+	}
+
+	// The side file stays on disk (the relay may still be draining its tail);
+	// it lives in the tracker's scratch dir, which the proxy sweeps later.
+	if (gTrackCksFile != NULL) {
+		fclose(gTrackCksFile);
+		gTrackCksFile = NULL;
+	}
+
+	gTrackSignatureFound = false;
+	gTrackFrameCount = 0;
+	gTrackRecordsConsumedAtSignature = 0;
+	gTrackChecksums.clear();
+	Track3srWriteManifest(false);
+}
