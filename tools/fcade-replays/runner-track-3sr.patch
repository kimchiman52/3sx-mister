+// Per PC-trigger frame, fed the same normalized RAM view + in-game gate the
+// .ram dump path uses. Mirrors make_3sr.py extract_scrd_game():
+//   - before the signature: scan for G_No[1]==2 && G_No[2]==0 && G_No[3]==0
+//     (the signature frame itself contributes NO input words);
+//   - after it: append the frame's {P1SW_0, P2SW_0} pair, sampling the
+//     13-field checksum when local_index % interval == 0.
+// Game segmentation (in-game -> not-in-game increments the game index) is
+// the same rule ReplayDumpCps3MainRam uses for game_N/ dump directories.
+static bool Track3srOnFrame(const UINT8* ram, size_t ramSize, bool isInGame)
+{
+	if (gTrackWasInGame && !isInGame) {
+		Track3srFinalizeGame("boundary");
+		gTrackGameIndex++;
+	}
+	gTrackWasInGame = isInGame;
+
+	if (!isInGame) {
+		return true;
+	}
+
+	if (!gTrackSignatureFound) {
+		const UINT16 gNo1 = ReplayReadBigEndianU16(ram, ramSize, kTrackGNoOffset + 2);
+		const UINT16 gNo2 = ReplayReadBigEndianU16(ram, ramSize, kTrackGNoOffset + 4);
+		const UINT16 gNo3 = ReplayReadBigEndianU16(ram, ramSize, kTrackGNoOffset + 6);
+		if (gNo1 == 2 && gNo2 == 0 && gNo3 == 0) {
+			if (!Track3srOpenGameFile(ram, ramSize)) {
+				return false;
+			}
+			gTrackSignatureFound = true;
+			gTrackRecordsConsumedAtSignature = (UINT64)(gReplayInputOffset / 10);
+		}
+		return true;
+	}
+
+	UINT8 words[4];
+	Track3srPutU16Le(&words[0], ReplayReadBigEndianU16(ram, ramSize, kTrackP1Sw0Offset));
+	Track3srPutU16Le(&words[2], ReplayReadBigEndianU16(ram, ramSize, kTrackP2Sw0Offset));
+	if (fwrite(words, 1, sizeof(words), gTrackGameFile) != sizeof(words)) {
+		printf("track-3sr: failed to append input words for game_%u\n", gTrackGameIndex);
+		return false;
+	}
+
+	if (kTrackChecksumInterval != 0 && (gTrackFrameCount % kTrackChecksumInterval) == 0) {
+		Track3srChecksumEntry entry;
+		entry.frame = gTrackFrameCount;
+		entry.hash = Track3srComputeChecksum(ram, ramSize);
+		gTrackChecksums.push_back(entry);
+
+		// Mirror the entry into the append-only side file NOW (same 8-byte
+		// LE encoding the .3sr table gets at finalize), flushed per entry
+		// (8 B/second of gameplay) so the watchpoll relay sees it promptly.
+		if (gTrackCksFile != NULL) {
+			UINT8 sideEntry[8];
+			Track3srPutU32Le(&sideEntry[0], entry.frame);
+			Track3srPutU32Le(&sideEntry[4], entry.hash);
+			if (fwrite(sideEntry, 1, sizeof(sideEntry), gTrackCksFile) != sizeof(sideEntry)) {
+				printf("track-3sr: warning: checksum side file write failed for game_%u\n", gTrackGameIndex);
+				fclose(gTrackCksFile);
+				gTrackCksFile = NULL;
+			} else {
+				fflush(gTrackCksFile);
+			}
+		}
+	}
+	gTrackFrameCount++;
+
+	return true;
+}
