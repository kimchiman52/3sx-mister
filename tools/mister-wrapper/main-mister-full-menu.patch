+/* ------------------------------------------------------------------
+ * Direct-P2P OSD state (Step 10 of docs/plan-stun-direct-p2p.md)
+ *
+ * Process-local state backing the "Direct P2P" submenu. The peer-code
+ * buffer holds the 12-char v4 room code (no dashes) being assembled
+ * via the on-screen keyboard below.
+ *
+ * Power-user knobs (CFG_KEY_NETPLAY_DIRECT_P2P_HOST_PORT and
+ * CFG_KEY_NETPLAY_DIRECT_P2P_DISABLE_UPNP) live in config.ini and are
+ * deliberately NOT exposed in the OSD — the default Host/Join flow is
+ * all the typical user sees. See docs/config.md.
+ *
+ * OSK layout: 6 columns x 7 rows. The first 6 rows spell out 0-9A-Z
+ * (36 chars) in order; row 6 holds the two action cells "BS" (erase
+ * last char) and "OK" (commit + transition to MENU_DIRECT_P2P_CONFIRM).
+ * All 12 code chars use the ISO 7064 MOD 37,36 alphabet (0-9A-Z) so
+ * every cell is needed — cannot drop I/L/O/U since the 12th (check)
+ * char may legally land on any of those.
+ * ------------------------------------------------------------------ */
+static int      g_dp2p_confirm_is_join = 0;
+
+static char     g_dp2p_code_buf[RECENT_JOIN_CODE_BUF];  /* 12 chars + NUL + slack */
+static int      g_dp2p_code_len     = 0;
+static int      g_dp2p_osk_row      = 0;
+static int      g_dp2p_osk_col      = 0;
+static int      g_dp2p_recent_sel   = 0;  /* cursor in Recently Joined list */
+
+#define DP2P_OSK_ROWS 7
+#define DP2P_OSK_COLS 6
+#define DP2P_CODE_CHAR_LEN 12
+#define DP2P_RECENT_MAX 10
+
+/* Row-major alphabet (0-9A-Z) then action cells on the final row. */
+static const char *direct_p2p_osk_cell(int row, int col)
+{
+	static char single[2] = {0, 0};
+	if (row >= 0 && row < 6)
+	{
+		int idx = row * DP2P_OSK_COLS + col; /* 0..35 */
+		if (idx < 10)
+		{
+			single[0] = (char)('0' + idx);
+			return single;
+		}
+		single[0] = (char)('A' + (idx - 10));
+		return single;
+	}
+	if (row == 6)
+	{
+		if (col == 0) return "BS";
+		if (col == 1) return "OK";
+		return " ";
+	}
+	return " ";
+}
+
+static char direct_p2p_osk_char_at(int row, int col)
+{
+	const char *c = direct_p2p_osk_cell(row, col);
+	if (strlen(c) == 1) return c[0];
+	return 0;
+}
+
+/* Dispatched from MENU_DIRECT_P2P_JOIN_ENTRY1 when the user presses A.
+ * Defined below (after the format helper) because it references the
+ * MENU_* enum values declared above and the file-scope `menustate`. */
+static void direct_p2p_osk_select(void);
+
+/* Compose the partial-code display line "   4ABCDEFGHJKM" with
+ * unfilled positions replaced by '_'. Writes NUL-terminated into out.
+ * No dash groups: v4 (task #155) is 12 chars with no hyphen groups —
+ * see room_code.h — so this no longer mirrors a dashed display form. */
+static void direct_p2p_format_entry_display(char *out, size_t out_cap)
+{
+	size_t o = 0;
+	if (out_cap < 4) { if (out_cap) out[0] = '\0'; return; }
+	out[o++] = ' '; out[o++] = ' '; out[o++] = ' ';
+	for (int i = 0; i < DP2P_CODE_CHAR_LEN && o + 1 < out_cap; i++)
+	{
+		if (i < g_dp2p_code_len) out[o++] = g_dp2p_code_buf[i];
+		else out[o++] = '_';
+	}
+	if (o < out_cap) out[o] = '\0';
+	else out[out_cap - 1] = '\0';
+}
+
+static void direct_p2p_osk_select(void)
+{
+	if (g_dp2p_osk_row == 6 && g_dp2p_osk_col == 0)
+	{
+		/* Backspace */
+		if (g_dp2p_code_len > 0)
+		{
+			g_dp2p_code_len--;
+			g_dp2p_code_buf[g_dp2p_code_len] = '\0';
+		}
+		menustate = MENU_DIRECT_P2P_JOIN_ENTRY;
+		return;
+	}
+	if (g_dp2p_osk_row == 6 && g_dp2p_osk_col == 1)
+	{
+		/* OK: commit only if the buffer holds a full 12-char code.
+		 * Checksum validation happens in the game via RoomCode_Decode
+		 * (Step 9 reader path); the wrapper forwards verbatim. */
+		if (g_dp2p_code_len == DP2P_CODE_CHAR_LEN)
+		{
+			g_dp2p_code_buf[g_dp2p_code_len] = '\0';
+			g_dp2p_confirm_is_join = 1;
+			menustate = MENU_DIRECT_P2P_CONFIRM;
+		}
+		return;
+	}
+	/* Alphanumeric cell. */
+	char ch = direct_p2p_osk_char_at(g_dp2p_osk_row, g_dp2p_osk_col);
+	if (!ch) return;
+	if (g_dp2p_code_len < DP2P_CODE_CHAR_LEN)
+	{
+		g_dp2p_code_buf[g_dp2p_code_len++] = ch;
+		g_dp2p_code_buf[g_dp2p_code_len] = '\0';
+	}
+	menustate = MENU_DIRECT_P2P_JOIN_ENTRY;
+}
+
+/* Render an epoch delta as a short "Xm/h/d ago" string or "just now" /
+ * "(unknown)" sentinel. Sized to fit alongside a 12-char code on a
+ * 32-column OSD row in the Recently Joined list (1 + 12 + 1 + 9 = 23). */
+static void direct_p2p_format_ago(long epoch, char *out, size_t out_cap)
+{
+	if (!out || out_cap == 0) return;
+	if (epoch <= 0) { snprintf(out, out_cap, "(unknown)"); return; }
+	long now = (long)time(NULL);
+	long delta = now - epoch;
+	if (delta < 0) delta = 0;
+	if (delta < 60)         snprintf(out, out_cap, "just now");
+	else if (delta < 3600)  snprintf(out, out_cap, "%ldm ago", delta / 60);
+	else if (delta < 86400) snprintf(out, out_cap, "%ldh ago", delta / 3600);
+	else                    snprintf(out, out_cap, "%ldd ago", delta / 86400);
+}
